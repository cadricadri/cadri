#!/usr/bin/env bash
# uv-backed Cadri CLI for a source checkout. Installed copies use the shim install.sh writes.
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
if ! command -v uv >/dev/null 2>&1; then
  echo "cadri: installing uv…" >&2
  curl -LsSf https://astral.sh/uv/install.sh | sh
  export PATH="${HOME}/.local/bin:${PATH}"
fi
exec uv run --quiet --project "$ROOT" python "$ROOT/bin/cadri_cli.py" "$@"
