# Rendered by the image entrypoint with envsubst; only CADRI_* variables are
# substituted (NGINX_ENVSUBST_FILTER), so nginx $variables pass through.

map $http_x_forwarded_proto $cadri_forwarded_proto {
    default $http_x_forwarded_proto;
    ""      $scheme;
}

map $http_x_forwarded_host $cadri_forwarded_host {
    default $http_x_forwarded_host;
    ""      $host;
}

server {
    # CADRI_TLS_LISTEN_PARAMS is "ssl" in the cluster and empty for local Docker.
    listen 8080 ${CADRI_TLS_LISTEN_PARAMS};
    server_name _;
    ${CADRI_TLS_DIRECTIVES}
    root /usr/share/nginx/html;
    server_tokens off;
    client_max_body_size 32m;

    gzip on;
    gzip_types text/css application/javascript application/json;

    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header X-Frame-Options "DENY" always;

    location ~ ^/(api/|auth/|healthz$) {
        proxy_pass ${CADRI_ENGINE_UPSTREAM};
        ${CADRI_PROXY_SSL_DIRECTIVES}
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $cadri_forwarded_proto;
        proxy_set_header X-Forwarded-Host $cadri_forwarded_host;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
    }

    # add_header in a location replaces the server-level headers, so repeat them.
    location /assets/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header X-Frame-Options "DENY" always;
    }

    location / {
        try_files $uri /index.html;
        add_header Cache-Control "no-cache" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header X-Frame-Options "DENY" always;
    }
}
